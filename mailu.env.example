# Mailu 2024.06: template for NEW installations, not a live-server backup.
# Copy to mailu.env and follow README.md, including the resolver instructions.
# Generate SECRET_KEY with: openssl rand -hex 16
SECRET_KEY=CHANGE_ME_GENERATE_WITH_OPENSSL_RAND_HEX_16
SUBNET=192.168.203.0/24
DOMAIN=example.com
HOSTNAMES=mail.example.com
POSTMASTER=admin
TLS_FLAVOR=letsencrypt
AUTH_RATELIMIT_IP=60/hour
AUTH_RATELIMIT_USER=100/day
DISABLE_STATISTICS=True

# Features matching docker-compose.yml
ADMIN=true
WEBMAIL=snappymail
API=false
API_TOKEN=
WEBDAV=radicale
ANTIVIRUS=none
SCAN_MACROS=true
FULL_TEXT_SEARCH=en
FULL_TEXT_SEARCH_ATTACHMENTS=true
FETCHMAIL_ENABLED=true
FETCHMAIL_DELAY=600

# Mail policy; leave RELAYNETS empty unless you need trusted unauthenticated relay.
MESSAGE_SIZE_LIMIT=50000000
MESSAGE_RATELIMIT=200/day
RELAYNETS=
RELAYHOST=
RECIPIENT_DELIMITER=+
DMARC_RUA=admin
DMARC_RUF=admin
WELCOME=false
WELCOME_SUBJECT=Welcome to your email account
WELCOME_BODY=Your email account is ready.
COMPRESSION=
COMPRESSION_LEVEL=

# Web interfaces
WEBROOT_REDIRECT=/webmail
WEB_ADMIN=/admin
WEB_WEBMAIL=/webmail
WEB_API=/api
SITENAME=Mailu
WEBSITE=https://mailu.io

# Advanced settings
CREDENTIAL_ROUNDS=12
REAL_IP_HEADER=
REAL_IP_FROM=
REJECT_UNLISTED_RECIPIENT=
LOG_LEVEL=INFO
TZ=Etc/UTC
DEFAULT_SPAM_THRESHOLD=80
